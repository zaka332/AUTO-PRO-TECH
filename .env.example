# ==============================================
# إعدادات Firebase — انسخ هذا الملف إلى .env ثم املأ القيم من:
# Firebase Console > Project Settings > Your apps > Web app > Config
# ملاحظة: مفاتيح Firebase الويب آمنة للنشر لكن الأفضل إبقاء .env خارج GitHub
# ==============================================

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# رقم واتساب المتجر بالصيغة الدولية دون + أو أصفار (مثال جزائري: 213xxxxxxxxx)
VITE_WHATSAPP_NUMBER=213500000000

# بريد مدير المتجر (نفس الحساب الذي تنشئه في Firebase Authentication)
VITE_ADMIN_EMAIL=admin@autoprotech.dz

# معرف Meta Pixel (اختياري — من Meta Events Manager)
VITE_FB_PIXEL_ID=

# رابط الموقع المنشور (يُستخدم في كتالوج فيسبوك والمشاركة)
VITE_SITE_URL=https://auto-pro-tech.web.app
